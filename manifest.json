{
  "manifest_version": 3,
  "name": "EdgeShield AdBlock",
  "version": "1.3.0",
  "description": "Microsoft Edge için hızlı, hafif ve gizlilik odaklı reklam ve takipçi engelleyici.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EdgeShield AdBlock",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["popup_guard.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_ads",
        "enabled": true,
        "path": "rules/ad_rules.json"
      },
      {
        "id": "ruleset_trackers",
        "enabled": true,
        "path": "rules/tracker_rules.json"
      },
      {
        "id": "ruleset_aggressive",
        "enabled": true,
        "path": "rules/aggressive_rules.json"
      },
      {
        "id": "ruleset_stealth",
        "enabled": true,
        "path": "rules/stealth_rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["stubs/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
